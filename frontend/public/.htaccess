# FSPPA-Formation — IONOS Hébergement Web Linux / Apache
# Copier tout le contenu de frontend/dist/ à la racine web du domaine.
Options -MultiViews
DirectoryIndex index.html
RewriteEngine On

# HTTPS obligatoire : activer auparavant le certificat SSL dans IONOS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

# Les pages pré-rendues sont /page/index.html ; les URL canoniques
# utilisent un slash final. Apache sert alors le bon fichier HTML.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ /$1/ [R=301,L,NE]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
