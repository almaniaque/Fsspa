# Port du serveur API
PORT=5000

# Connexion MongoDB (Atlas ou local)
MONGO_URI=mongodb://localhost:27017/fsppa-formation

# URL du frontend autorisée (CORS)
CLIENT_URL=http://localhost:5173

# Adresse e-mail professionnelle qui reçoit les demandes de devis
ADMIN_EMAIL=contact@fsppa-formation.fr

# Identifiants SMTP pour l'envoi d'e-mail (ex : Gmail, OVH, SendGrid SMTP...)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=votre-adresse@example.com
EMAIL_PASS=votre-mot-de-passe-application
